# Copier ce fichier en .env puis renseigner les clés de test Stripe (https://dashboard.stripe.com/test/apikeys).
PORT=4321
SITE_URL=http://localhost:4321

# Clé secrète (sk_test_...) : utilisée côté serveur uniquement.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...) : fourni par `stripe listen --forward-to localhost:4321/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
